# Browser
VITE_API_BASE_URL=http://localhost:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Application API (never expose these values to the browser)
API_PORT=8787
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
COMPILER_URL=http://localhost:8788
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=
OPENAI_EXTRACTION_MODEL=
KOFI_VERIFICATION_TOKEN=
KOFI_PAYMENT_URL=

# Isolated compiler
COMPILER_PORT=8788
TECTONIC_UNTRUSTED_MODE=1
COMPILER_TIMEOUT_MS=10000
COMPILER_MAX_SOURCE_BYTES=262144
COMPILER_CACHE_DIR=/tmp/draftwise-cache
COMPILER_VERSION=tectonic
PACKAGE_BUNDLE_VERSION=v1
